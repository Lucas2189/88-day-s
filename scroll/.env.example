# ---------------------------------------------------------------------------
# SCROLL · environment variables
# Copy to .env.local. Everything is OPTIONAL: without any key the app runs in
# local mode with demo content + user-submitted links through public oEmbed.
# Never commit .env.local. Server-only keys have no NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Supabase (auth + cloud sync of bookmarks/preferences) -----------------
# Project settings → API. Run supabase/migrations/0001_init.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- YouTube Data API v3 (optional) ----------------------------------------
# Enables channel/playlist discovery feeds and search. Default quota: 10,000 units/day
# + 100 search.list calls/day. https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Comma-separated PUBLIC playlist ids used as the YouTube discovery feed (1 quota unit per page).
YOUTUBE_FEED_PLAYLIST_IDS=

# --- Meta / Instagram oEmbed (optional) ------------------------------------
# Tokenless access works for public content since 2026-06-15. Providing an app id + client token
# ("app access token") raises the rate limit. https://developers.facebook.com/docs/instagram-platform/oembed
META_APP_ID=
META_CLIENT_TOKEN=

# --- Reddit Data API (optional) --------------------------------------------
# Requires a registered AND approved Reddit app (https://www.reddit.com/prefs/apps). Non-commercial use only
# unless you have a written agreement with Reddit. Free tier: 100 queries/min per client id.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Comma-separated subreddits for the discovery feed (default: videos,funny,aww,science,gaming)
REDDIT_FEED_SUBREDDITS=

# --- TikTok / X --------------------------------------------------------------
# No credentials needed: public oEmbed + official embed players only. No feed/search API available.
